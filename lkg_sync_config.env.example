# lkg_sync_config.env.example
# Configuration for run_lkg_sync_multi.sh

# Video files (relative to the script directory)
V1_FILE="display2_combined.mp4"
V2_FILE="display1_combined.mp4"

# Calibration files
# If empty, the player will fall back to its internal lkg_calibration.json or default values.
CALIB1="/home/nttdmse/share/calibration/LKG-E12651.json"
CALIB2="/home/nttdmse/share/calibration/LKG-E12592.json"

# Display Settings
DISPLAY_NUM=${DISPLAY:-:1}
